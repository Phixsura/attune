flowchart TB
    subgraph Ingestion["1. Ingestion"]
        API["POST /v1/feedback/ingest"]
        IngestHandler["Ingest Handler"]
        API --> IngestHandler
    end

    subgraph Enrichment["2. Enrichment Pipeline"]
        direction TB
        Claim["TryClaim\n(atomic lock)"]
        Load["LoadForEnrich\n(content + config)"]
        Triage{"Triage"}
        LLM["LLM Client\n(classification)"]
        Parse["Parse + Gate 2\n(whitelist filter)"]
        Persist["persistEnriched\n(tx: feedback + outbox)"]

        Claim --> Load
        Load --> Triage
        Triage -->|"ignore"| MarkIgnored["Mark Ignored"]
        Triage -->|"full"| LLM
        LLM --> Parse
        Parse --> Persist
    end

    subgraph AsyncFanout["3. Async Dispatch"]
        FanOut["fanOut\n(goroutine)"]
        Webhook["Raw Webhook"]
        GitHub["GitHub Issue"]

        FanOut --> Webhook
        FanOut --> GitHub
    end

    subgraph AsyncEmbed["4. Async Embedding (Outbox)"]
        direction TB
        TaskTable[("embedding_task\n─────────────\nfeedback_id\nstatus\nclaimed_at")]
        EmbedWorker["EmbeddingWorker\n(outbox poll)"]
        EmbedClient["EmbeddingClient\nOpenAI API"]
        EmbedReq["POST /v1/embeddings\ntext-embedding-3-small"]
        Vector["[]float32\n(256 dims)"]
        Audit["llm_audit\npurpose='embed'"]

        TaskTable --> EmbedWorker
        EmbedWorker --> EmbedClient
        EmbedClient --> EmbedReq
        EmbedReq --> Vector
        EmbedWorker --> Audit
    end

    subgraph Clustering["5. Similarity & Clustering"]
        direction TB
        FindSim["FindSimilar\n(cosine > 0.85)"]
        HNSW["HNSW Index\n(pgvector)"]
        Decision{"Similar\nfound?"}
        Inherit["Inherit\ncluster_id"]
        NewUUID["New UUID\ncluster_id"]
        UpdateEmbed["UpdateEmbedding\n(embedding + cluster_id)"]

        FindSim --> HNSW
        HNSW --> Decision
        Decision -->|"yes"| Inherit
        Decision -->|"no"| NewUUID
        Inherit --> UpdateEmbed
        NewUUID --> UpdateEmbed
    end

    subgraph Storage["6. PostgreSQL"]
        direction LR
        FeedbackTable[("user_feedback\n─────────────\nid\ncontent\nenriched_title\nenriched_attrs\nembedding VECTOR(256)\nembedding_model\ncluster_id UUID")]
    end

    subgraph ConsoleAPI["7. Console API"]
        ListClusters["GET /clusters\n(cluster summaries)"]
        GetMembers["GET /clusters/{id}/members\n(cluster items)"]
        ClusterHandler["Cluster Handler"]

        ListClusters --> ClusterHandler
        GetMembers --> ClusterHandler
    end

    %% Main flow connections
    IngestHandler -->|"INSERT\nstatus=pending"| FeedbackTable
    FeedbackTable -->|"poll pending"| Claim
    Persist -->|"UPDATE\nstatus=enriched"| FeedbackTable

    %% Async boundaries (dashed)
    Persist -.->|"go func()"| FanOut
    Persist -.->|"INSERT task"| TaskTable

    %% Embedding flow
    Vector --> FindSim
    UpdateEmbed -->|"UPDATE\nembedding + cluster_id"| FeedbackTable

    %% Console queries
    ClusterHandler -->|"SELECT\nGROUP BY cluster_id"| FeedbackTable

    %% Styling
    classDef async fill:#4a5568,stroke:#718096,color:#fff
    classDef storage fill:#2d3748,stroke:#4a5568,color:#fff
    classDef api fill:#3182ce,stroke:#2b6cb0,color:#fff
    classDef decision fill:#d69e2e,stroke:#b7791f,color:#fff

    class FanOut,EmbedWorker async
    class FeedbackTable,TaskTable,Audit storage
    class API,ListClusters,GetMembers api
    class Triage,Decision decision
