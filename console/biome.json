{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.{ts,tsx,js,jsx,json,jsonc}",
      "e2e/**/*.{ts,tsx,js,jsx,json,jsonc}",
      "vite.config.ts",
      "playwright.config.ts",
      "biome.json",
      "components.json"
    ],
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": true
      },
      "correctness": {
        "recommended": true,
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "recommended": true
      },
      "style": {
        "useImportType": "error",
        "useExportType": "error",
        "useConsistentArrayType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/routeTree.gen.ts", "src/proto/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/**/*.test.{ts,tsx}", "src/testing/**"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "style": { "useImportType": "off" }
        }
      }
    }
  ]
}
