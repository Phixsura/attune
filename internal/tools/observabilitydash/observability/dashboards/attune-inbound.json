{
  "uid": "attune-inbound",
  "title": "Attune Inbound",
  "description": "Generated by go run ./internal/tools/observabilitydash. Do not edit JSON by hand. Source health for webhook, email, and poll-mode inbound adapters.",
  "tags": [
    "attune",
    "inbound"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": null,
        "query": "label_values(attune_inbound_total, tenant)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "channel",
        "type": "query",
        "datasource": null,
        "query": "label_values(attune_inbound_total, channel)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Inbound SLA lens",
      "description": "How to read inbound health.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "**Targets:** availability \u003e= 99% · error rate \u003c= 1% · p95 intake \u003c= 2s · freshness \u003e= 99% · stale sources = 0\n\n**Read order:** SLA cards first, then freshness coverage, then source-level attribution.",
        "mode": "markdown"
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "SLA at a glance",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Availability SLI",
      "description": "Share of inbound events not ending in an error result. When there is no traffic, this stays green and Events shows the system is idle.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "(1 - (((sum(increase(attune_inbound_total{tenant=~\"$tenant\",channel=~\"$channel\",result!=\"ok\"}[$__range]))) or vector(0)) / clamp_min(((sum(increase(attune_inbound_total{tenant=~\"$tenant\",channel=~\"$channel\"}[$__range]))) or vector(0)), 1))) or vector(0)",
          "legendFormat": "Availability SLI",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "displayName": "Availability SLI",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "unit": "percentunit"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error rate",
      "description": "Inbound adapter error share in the selected range. A spike usually means a source credential, payload shape, or upstream API changed.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "expr": "((sum(increase(attune_inbound_total{tenant=~\"$tenant\",channel=~\"$channel\",result!=\"ok\"}[$__range])) / clamp_min(sum(increase(attune_inbound_total{tenant=~\"$tenant\",channel=~\"$channel\"}[$__range])), 1)) or vector(0)) or vector(0)",
          "legendFormat": "Error rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "displayName": "Error rate",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "P95 intake latency",
      "description": "End-to-end inbound processing latency p95. This should stay under 2 seconds for normal source intake.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "expr": "((histogram_quantile(0.95, sum by (le) (rate(attune_inbound_latency_seconds_bucket{tenant=~\"$tenant\",channel=~\"$channel\"}[$__rate_interval])))) or vector(0)) or vector(0)",
          "legendFormat": "P95 intake latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "displayName": "P95 intake latency",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "s"
        }
      },
      "options": {
        "colorMode": "value",
