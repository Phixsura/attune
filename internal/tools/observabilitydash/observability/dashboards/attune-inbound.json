    },
    {
      "id": 6,
      "type": "stat",
      "title": "Freshness SLI",
      "description": "Share of enabled poll-mode sources that are not stale. When no poll sources are enabled, this stays green and Enabled sources shows zero.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 9
