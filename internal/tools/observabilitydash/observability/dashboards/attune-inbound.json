      "targets": [
        {
          "expr": "(1 - (((count(attune_inbound_poll_lag_seconds{tenant=~\"$tenant\",channel=~\"$channel\"} \u003e 900)) or vector(0)) / clamp_min(((sum(attune_inbound_source_state{tenant=~\"$tenant\",channel=~\"$channel\",state=\"enabled\"})) or vector(0)), 1))) or vector(0)",
          "legendFormat": "Freshness SLI",
          "refId": "A"
