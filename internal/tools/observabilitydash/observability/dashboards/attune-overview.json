{
  "uid": "attune-overview",
  "title": "Attune Overview",
  "description": "Generated by go run ./internal/tools/observabilitydash. Do not edit JSON by hand. First stop for on-call: RED/golden-signal health, then tenant/source drilldowns.",
  "tags": [
    "attune"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": null,
        "query": "label_values(attune_ingest_total, tenant)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 101,
      "type": "text",
      "title": "SLO command center",
      "description": "How to read overall Attune health.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "**Targets:** validation error \u003c= 2% · rate-limit pressure expected only during bursts · enrichment p95 \u003c= 5s · outbox lag \u003c= 60s · provider/security risk near zero\n\n**Flow:** golden signals -\u003e tenant attribution -\u003e AI/ops/security risk -\u003e domain drilldowns.",
        "mode": "markdown"
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Golden signals",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Requests",
      "description": "Accepted + rejected ingest requests in the selected time range. If this drops unexpectedly, check inbound sources and client API traffic first.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "((sum(increase(attune_ingest_total{tenant=~\"$tenant\"}[$__range]))) or vector(0)) or vector(0)",
          "legendFormat": "Requests",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "displayName": "Requests",
          "noValue": "0",
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Validation error %",
      "description": "Share of ingest requests rejected by request validation over the selected range. Rising values usually mean client schema drift or malformed source payloads.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "expr": "((sum(increase(attune_ingest_total{tenant=~\"$tenant\",result=\"validate_err\"}[$__range])) / clamp_min(sum(increase(attune_ingest_total{tenant=~\"$tenant\"}[$__range])), 1)) or vector(0)) or vector(0)",
          "legendFormat": "Validation error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "displayName": "Validation error %",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "unit": "percentunit"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
