    {
      "id": 12,
      "type": "barchart",
      "title": "Tenant burn ranking",
      "description": "Current 5m burn multipliers for tenant-scoped SLOs. Use this to answer who is burning budget fastest before opening the detailed SLO pages.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "topk(10, (attune:ingest_service_failure_ratio:ratio5m) / 0.001)",
          "legendFormat": "{{tenant}} / ingest",
          "refId": "A"
        },
        {
          "expr": "topk(10, ((1 - attune:enrich_success_under_5s:ratio5m)) / 0.05)",
          "legendFormat": "{{tenant}} / enrich",
          "refId": "B"
        },
        {
          "expr": "topk(10, (sum by (tenant) (rate(attune_mcp_tool_calls_total{result=~\"client_error|internal_error\"}[5m])) / clamp_min(sum by (tenant) (rate(attune_mcp_tool_calls_total{result=~\"ok|client_error|internal_error\"}[5m])), 1e-9)) / 0.001)",
          "legendFormat": "{{tenant}} / mcp",
          "refId": "C"
        },
        {
          "expr": "topk(10, (1 - (\n\t\t\tsum by (tenant) (rate(attune_gdpr_job_total{result=\"completed\"}[5m]))\n\t\t\t/\n\t\t\tclamp_min(\n\t\t\t\tsum by (tenant) (rate(attune_gdpr_job_total{result=\"started\"}[5m]))\n\t\t\t\t- (\n\t\t\t\t\tsum by (tenant) (rate(attune_gdpr_job_total{result=\"cancelled\"}[5m]))\n\t\t\t\t\tor on(tenant) (\n\t\t\t\t\t\tsum by (tenant) (rate(attune_gdpr_job_total{result=\"started\"}[5m])) * 0\n\t\t\t\t\t)\n\t\t\t\t)\n\t\t\t\t- (\n\t\t\t\t\tsum by (tenant) (rate(attune_gdpr_job_total{result=\"revoked\"}[5m]))\n\t\t\t\t\tor on(tenant) (\n\t\t\t\t\t\tsum by (tenant) (rate(attune_gdpr_job_total{result=\"started\"}[5m])) * 0\n\t\t\t\t\t)\n\t\t\t\t),\n\t\t\t\t1e-9\n\t\t\t)\n\t\t)) / 0.001)",
          "legendFormat": "{{tenant}} / gdpr",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "noValue": "0",
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "orientation": "horizontal"
      }
    },
