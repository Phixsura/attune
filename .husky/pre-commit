#!/usr/bin/env bash
# attune — pre-commit gate. A fast, dependency-free local mirror of the quick
# CLAUDE.md §1 checks plus the standard large-file guard, run on STAGED changes
# so policy violations surface in seconds instead of a CI round-trip.
#
# CI remains the authoritative full gate (vet/build/test/golangci/lizard/console);
# this hook is best-effort local feedback — a SUBSET of CI, never stricter.
#
#   Enable:   git config core.hooksPath .husky
#   Bypass:   git -c core.hooksPath=/dev/null commit ...   (emergencies only)
#
# Notes:
#   • This file MUST stay executable (+x). With core.hooksPath, git silently
#     skips a non-executable hook. It is committed mode 100755, so fresh clones
#     are fine; don't strip the bit.
#   • The console step is best-effort: it runs console's OWN biome only when
#     console/src files are staged AND console deps are installed — Go-only
#     contributors never need node_modules.
#
# Checks:
#   ① large-file guard — a NEWLY-ADDED file whose blob is > 500 KB (catches stray
#      binaries/dumps). Matches pre-commit's check-added-large-files, which scopes
#      to ADDED files: a tracked file growing past the limit (e.g. pnpm-lock.yaml,
#      go.sum) is a modification and is intentionally NOT re-checked, so dep bumps
#      never get blocked. Escapes for a legit large add: git-lfs (its pointer blob
#      is ~130 B → passes automatically), or a one-off bypass. We do NOT cap source
#      LINES: Go/Google style cap functions not files (CI's lizard already does).
#   ② go vet — packages touched by staged .go (blocks)
#   ③ scripts/lint-slog.sh — rule-2/rule-3 pattern checks (--strict; blocks)
#   ④ scripts/lint-integration-layout.sh — keeps integration suites centralized
#      under test/integration/** (blocks)
#   ⑤ scripts/lint-rawptr.sh — bans bare *p / &x (blocks)
#   ⑥ golangci-lint run — incremental on changed files (blocks). Caches under
#      ~/.cache/golangci-lint so cached re-runs are sub-second on small diffs;
#      this is the local source of truth for the depguard slog-facade rule
#      (#48) and the §5 layering rules.
#   ⑦ biome — staged console/src files (blocks, only if console deps present)

set -uo pipefail  # NOT -e: we accumulate failures and decide the exit ourselves.

if [ -t 1 ]; then B=$'\033[1m'; R=$'\033[0m'; else B=''; R=''; fi
say(){ printf '%s▸ %s%s\n' "$B" "$1" "$R"; }
fail=0

# ── ① large-file guard — NEWLY-ADDED blobs only (à la check-added-large-files) ─
MAXKB=500
large_file_allowlist='^internal/infra/llmclient/model_prices_and_context_window\.json$'
say "large-file guard (≤${MAXKB}KB, new files)"
while IFS= read -r f; do
  if printf '%s\n' "$f" | grep -Eq "$large_file_allowlist"; then
    continue
  fi
  sz=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  if [ "$((sz / 1024))" -gt "$MAXKB" ]; then
    echo "✗ $f: $((sz / 1024))KB (>${MAXKB}KB) — large/binary blob; use git-lfs, or bypass for a one-off"
    fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=A)

# ── ①b proposal location — must go into YYYY/MM/, not root (#72) ─────────────
root_proposals=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^docs/proposals/[^/]+\.md$' | grep -v '^docs/proposals/README\.md$' || true)
if [ -n "$root_proposals" ]; then
  say "proposal location"
  echo "✗ proposals must go into docs/proposals/YYYY/MM/, not the root:"
  printf '    %s\n' $root_proposals
  fail=1
fi

# ── ② go vet on staged packages (array → space-safe, no fragile xargs) ────────
go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -n "$go_files" ]; then
  say "go vet"
  pkgs=()
  while IFS= read -r d; do pkgs+=("./$d"); done \
    < <(while IFS= read -r f; do dirname "$f"; done <<< "$go_files" | sort -u)
  go vet "${pkgs[@]}" || fail=1
fi

# ── ③ slog/OTel lint (--strict gate; #4 / #9) ────────────────────────────────
if [ -f scripts/lint-slog.sh ]; then
  say "lint-slog (--strict)"
  bash scripts/lint-slog.sh --strict || fail=1
fi

# ── ④ integration layout — centralizes build-tagged integration suites ───────
if [ -f scripts/lint-integration-layout.sh ]; then
  say "lint-integration-layout"
  bash scripts/lint-integration-layout.sh || fail=1
fi

# ── ⑤ raw-pointer lint — bans bare *p / &x in favour of internal/pkg/ptrext ──
if [ -f scripts/lint-rawptr.sh ]; then
  say "lint-rawptr"
  bash scripts/lint-rawptr.sh || fail=1
fi

# ── ⑥ golangci-lint — depguard §5 layering + slog-facade ban (#48) ────────────
# Cached on disk so re-runs on small diffs are sub-second; skipped quietly when
# the toolchain is absent (CI runs the full lint authoritatively either way).
if [ -n "$go_files" ] && command -v golangci-lint >/dev/null 2>&1; then
  say "golangci-lint"
  golangci-lint run || fail=1
fi

# ── ⑥b lizard — function complexity (CCN ≤15, NLOC ≤100) ─────────────────────
# Skipped quietly when lizard is absent; `pip install lizard` to enable locally.
if [ -n "$go_files" ] && command -v lizard >/dev/null 2>&1; then
  say "lizard (CCN ≤15, NLOC ≤100)"
  lizard . -l go -C 15 -T nloc=100 --warnings_only || fail=1
fi

# ── ⑦ console biome — staged console/src only, guarded on installed deps ──────
con=$(git diff --cached --name-only --diff-filter=ACM -- 'console/src/**' \
      | grep -E '\.(ts|tsx|js|jsx|json)$' || true)
if [ -n "$con" ]; then
  if [ -x console/node_modules/.bin/biome ]; then
    say "biome (staged console/src)"
    ( cd console && ./node_modules/.bin/biome check $(printf '%s\n' "$con" | sed 's#^console/##') ) || fail=1
  else
    echo "⚠ console/src staged but console/node_modules absent — run 'pnpm -C console install' for local biome (CI checks regardless)"
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "pre-commit blocked — fix the above, or bypass (emergencies): git -c core.hooksPath=/dev/null commit"
  exit 1
fi
echo "${B}✓ pre-commit ok${R}"
