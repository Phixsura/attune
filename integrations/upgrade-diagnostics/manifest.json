{
  "schemaVersion": "attune.upgrade_diagnostics.v1",
  "diagnosticChecks": [
    {
      "id": "install_health",
      "title": "Install and connector health",
      "category": "install",
      "evidenceSource": "external-sync-health",
      "failureSignals": ["quarantined_connection", "degraded_connection", "failed_credential_test"],
      "recoveryAction": "resume_or_reauthorize_connection",
      "owner": "Developer Platform + Integrations"
    },
    {
      "id": "permission_boundary",
      "title": "Permission boundary",
      "category": "permissions",
      "evidenceSource": "integration-catalog",
      "failureSignals": ["missing_scope", "blank_data_class", "least_privilege_missing"],
      "recoveryAction": "review_scopes_before_upgrade",
      "owner": "Security + Developer Platform"
    },
    {
      "id": "schema_drift",
      "title": "Schema drift and mapping safety",
      "category": "schema",
      "evidenceSource": "field-mapping-workbench",
      "failureSignals": ["required_field_missing", "provider_field_removed", "invalid_mapping_json"],
      "recoveryAction": "preview_mapping_before_backfill",
      "owner": "Integrations + Product Ops"
    },
    {
      "id": "webhook_readiness",
      "title": "Webhook readiness",
      "category": "webhook",
      "evidenceSource": "connector-conformance",
      "failureSignals": ["signature_failed", "secret_missing", "unreplayable_event"],
      "recoveryAction": "rotate_secret_and_replay_fixture",
      "owner": "Security + Integrations"
    },
    {
      "id": "fixture_replay",
      "title": "Fixture replay coverage",
      "category": "replay",
      "evidenceSource": "connector-conformance",
      "failureSignals": ["fixture_missing", "normalization_mismatch", "dedupe_unstable"],
      "recoveryAction": "refresh_replay_fixture",
      "owner": "Developer Platform + QA"
    },
    {
      "id": "version_compatibility",
      "title": "Version compatibility and rollback",
      "category": "upgrade",
      "evidenceSource": "integration-catalog",
      "failureSignals": ["breaking_change", "rollback_missing", "migration_unverified"],
      "recoveryAction": "run_compatibility_migration_plan",
      "owner": "Developer Platform + Release"
    }
  ],
  "compatibilityMatrix": [
    {
      "connector": "jira",
      "currentVersion": "2026.07",
      "targetVersion": "2026.08",
      "compatibility": "non_breaking",
      "rollback": true
    },
