  ],
  "recoveryPlaybooks": [
    {
      "action": "resume_or_reauthorize_connection",
      "steps": ["rerun credential test", "resume quarantined connector", "verify newest successful run"]
    },
    {
      "action": "review_scopes_before_upgrade",
      "steps": ["compare live scopes", "confirm least privilege", "write audit note"]
    },
    {
      "action": "preview_mapping_before_backfill",
      "steps": ["run schema discovery", "preview mapping", "request backfill after approval"]
    },
    {
      "action": "rotate_secret_and_replay_fixture",
      "steps": ["rotate webhook secret", "verify signature", "replay sample event"]
    },
    {
      "action": "refresh_replay_fixture",
      "steps": ["record provider payload", "normalize fixture", "run conformance verifier"]
    },
    {
      "action": "run_compatibility_migration_plan",
      "steps": ["validate target version", "run fixture migration", "confirm rollback path"]
    }
  ],
  "fixtures": [
    {
      "name": "github upgrade diagnostics",
