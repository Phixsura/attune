# ─────────────────────────────────────────────────────────────────────────
# attune deploy env. Copy to `.env` and fill in:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# `docker compose` reads this file for both container env (env_file) and
# ${VAR} interpolation in docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────

# ── Postgres (consumed by the postgres container) ────────────────────────
POSTGRES_USER=attune
# REQUIRED — left empty on purpose so a misconfigured first boot fails loudly
# instead of running on a known-default password. Set a strong value, and keep
# it in sync with FEEDBACK_API_DATABASE_URL below.
POSTGRES_PASSWORD=
POSTGRES_DB=attune

# ── attune → Postgres connection ──────────────────────────────────────────
# Host is the compose service name `postgres`. sslmode=disable because the
# connection never leaves the compose network (postgres:17-alpine serves
# plaintext). Put the SAME password as POSTGRES_PASSWORD into the slot below.
FEEDBACK_API_DATABASE_URL=postgres://attune:@postgres:5432/attune?sslmode=disable

# ── LLM enrichment — any OpenAI-compatible /v1/chat/completions backend ──
# The stack BOOTS and /healthz passes without this, but enrichment calls will
# 401 until it's a real key — check `docker compose logs attune` for the key.
FEEDBACK_API_LLM_OPENAI_API_KEY=sk-...
# Endpoint base URL (attune appends /v1/chat/completions itself).
# Defaults to https://api.openai.com when unset. Examples:
#   Azure:  https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   local:  http://host.docker.internal:11434  (ollama; Linux needs extra_hosts)
# FEEDBACK_API_LLM_OPENAI_BASE_URL=https://api.openai.com
# Model id sent on every enrich call. Defaults to gpt-4o-mini (cheap +
# capable on short text classification). Override when your gateway
# aliases the name (e.g. "gpt-5.5", "gpt-4o-mini-2024-07-18").
# FEEDBACK_API_LLM_MODEL=gpt-4o-mini

# ── Image / port ─────────────────────────────────────────────────────────
# Host interface to bind. Loopback by default; set 0.0.0.0 to publish widely
# (do so only behind your own TLS proxy).
# ATTUNE_BIND=127.0.0.1
# ATTUNE_PORT=8090
# Pin a release instead of the moving :latest tag (recommended for prod). A
# digest pin is strongest:  ATTUNE_IMAGE=ghcr.io/phixsura/attune@sha256:<digest>
# ATTUNE_IMAGE=ghcr.io/phixsura/attune:v0.2.0

# ── Observability overlay (docker-compose.obs.yml — optional) ────────────
# Only used when you layer the obs overlay:
#   docker compose -f docker-compose.yml -f docker-compose.obs.yml up -d
# Grafana admin password. Empty ⇒ Grafana falls back to admin/admin and forces a
# change on first login. SET THIS for any shared/persistent deploy.
GF_SECURITY_ADMIN_PASSWORD=
# Host ports for the obs UIs (bound to ATTUNE_BIND, loopback by default).
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090

# ── Inbound Lark/Feishu event webhook (optional — blank ⇒ handler 404s) ──
# From the Lark Open Platform "事件订阅" tab. DEFAULT_TENANT_SLUG is REQUIRED
# when SIGNING_SECRET is set, and the slug must already exist.
# FEEDBACK_API_LARK_SIGNING_SECRET=
# FEEDBACK_API_LARK_VERIFICATION_TOKEN=
# FEEDBACK_API_LARK_DEFAULT_TENANT_SLUG=

# ── Outbound Lark group-bot webhooks (optional — blank ⇒ disabled) ───────
# FEEDBACK_API_FEEDBACK_POOL_WEBHOOK_URL=
# FEEDBACK_API_FEEDBACK_POOL_WEBHOOK_SECRET=
# FEEDBACK_API_DEV_RADAR_WEBHOOK_URL=
# FEEDBACK_API_DEV_RADAR_WEBHOOK_SECRET=

# ── Per-tenant rate limit (optional — defaults shown) ────────────────────
# FEEDBACK_API_RATE_LIMIT_PER_MINUTE=60
# FEEDBACK_API_RATE_LIMIT_BURST=300
# FEEDBACK_API_RATE_LIMIT_DISABLED=false

# ── Web console ──────────────────────────────────────────────────────────
# The console UI is a SEPARATE deployment (its own front-door + image + a
# local-login feature) tracked in a follow-up issue — intentionally NOT
# configured here. Setting CONSOLE_* / LARK_APP_* without that front door will
# only make the server refuse to boot.
