# ─────────────────────────────────────────────────────────────────────────
# attune deploy env. Copy to `.env` and fill in:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# `docker compose` reads this file for Postgres env and ${VAR} interpolation.
# The attune process itself reads deploy/config.yaml only.
# ─────────────────────────────────────────────────────────────────────────

# ── Postgres (consumed by the postgres container) ────────────────────────
POSTGRES_USER=attune
# REQUIRED — left empty on purpose so a misconfigured first boot fails loudly
# instead of running on a known-default password. Set a strong value, and keep
# it in sync with database.url in config.yaml.
POSTGRES_PASSWORD=
POSTGRES_DB=attune

# ── Image / port ─────────────────────────────────────────────────────────
# Host interface to bind. Loopback by default; set 0.0.0.0 to publish widely
# (do so only behind your own TLS proxy).
# ATTUNE_BIND=127.0.0.1
# ATTUNE_PORT=8090
# Pin a release instead of the moving :latest tag (recommended for prod). A
# digest pin is strongest:  ATTUNE_IMAGE=ghcr.io/phixsura/attune@sha256:<digest>
# ATTUNE_IMAGE=ghcr.io/phixsura/attune:v0.2.0

# ── Observability overlay (docker-compose.obs.yml — optional) ────────────
# Only used when you layer the obs overlay:
#   docker compose -f docker-compose.yml -f docker-compose.obs.yml up -d
# Grafana admin password. Empty ⇒ Grafana falls back to admin/admin and forces a
# change on first login. SET THIS for any shared/persistent deploy.
GF_SECURITY_ADMIN_PASSWORD=
# Host ports for the obs UIs (bound to ATTUNE_BIND, loopback by default).
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090

# Application config lives in config.yaml, including database.url, console
# bootstrap, observability, rate limits, and the Tink keyset used for encrypted
# runtime secrets.
