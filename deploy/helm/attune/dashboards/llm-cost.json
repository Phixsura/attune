{
  "uid": "attune-llm-cost",
  "title": "Attune LLM Cost",
  "description": "Generated by go run ./internal/tools/observabilitydash. Do not edit JSON by hand.",
  "tags": [
    "attune",
    "llm",
    "cost"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": null,
        "query": "label_values(attune_llm_calls_total, tenant)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "type": "query",
        "datasource": null,
        "query": "label_values(attune_llm_calls_total, model)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Cost and provider lens",
      "description": "How to read LLM cost and provider health.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "**Targets:** Provider errors = 0 · Spend attributable by tenant/model · Token mix explainable · Cost changes match traffic changes\n\n**Flow:** spend summary -\u003e cost attribution -\u003e token mix -\u003e provider errors.",
        "mode": "markdown"
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Spend summary",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM cost",
      "description": "Estimated LLM spend in the selected range. Use model and tenant breakdowns before changing routing or limits.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "((sum(increase(attune_llm_cost_usd_total{tenant=~\"$tenant\",model=~\"$model\"}[$__range]))) or vector(0)) or vector(0)",
          "legendFormat": "LLM cost",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "displayName": "LLM cost",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "unit": "currencyUSD"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      }
