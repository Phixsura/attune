{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "profile": {
      "type": "string",
      "enum": ["dev", "production"]
    },
    "app": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReadySeconds": { "type": "integer", "minimum": 0 },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": { "type": "array" }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "rollout": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "color": { "type": "string" },
        "trafficService": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string" },
            "activeColor": { "type": "string" },
            "annotations": { "type": "object" },
            "appProtocol": { "type": "string" }
          }
        }
      }
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "topologySpread": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxSkew": { "type": "integer", "minimum": 1 },
        "topologyKey": { "type": "string", "minLength": 1 },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": ["DoNotSchedule", "ScheduleAnyway"]
        }
      }
    },
    "topologySpreadConstraints": { "type": "array" },
    "probes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "startup": { "$ref": "#/definitions/httpProbe" },
        "liveness": { "$ref": "#/definitions/httpProbe" },
        "readiness": { "$ref": "#/definitions/httpProbe" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": { "type": "object" },
        "appProtocol": { "type": "string" },
        "loadBalancerClass": { "type": "string" },
        "loadBalancerIP": { "type": "string" },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": { "type": "string" }
        },
        "externalTrafficPolicy": { "type": "string" },
        "ipFamilyPolicy": { "type": "string" },
        "ipFamilies": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "additionalProperties": true,
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "additionalProperties": true,
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "pathType": {
                      "type": "string",
                      "enum": ["Exact", "ImplementationSpecific", "Prefix"]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 0 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": { "type": "array" },
        "egress": { "type": "array" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "existingSecret": { "type": "string" },
        "existingSecretChecksum": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 },
        "mountPath": { "type": "string", "minLength": 1 },
        "render": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "databaseURL": { "type": "string" },
            "enricher": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "interval": { "type": "string" },
                "batch": { "type": "integer", "minimum": 1 }
              }
            },
            "audit": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "retentionDays": { "type": "integer", "minimum": 1 },
                "pruneInterval": { "type": "string" }
              }
            },
            "shutdown": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "drainDelay": { "type": "string" },
                "timeout": { "type": "string" }
              }
            },
            "console": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "baseURL": { "type": "string" },
                "sessionKey": { "type": "string" }
              }
            },
            "secrets": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "tinkKeyset": { "type": "string" },
                "legacyInboundMasterKey": { "type": "string" }
              }
            },
            "observability": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "serviceVersion": { "type": "string" },
                "environment": { "type": "string" },
                "otlpEndpoint": { "type": "string" },
                "otlpTracesPath": { "type": "string" },
                "otlpHeaders": { "type": "object" },
                "otlpInsecure": { "type": "boolean" }
              }
            },
            "rateLimit": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "perMinute": { "type": "integer", "minimum": 1 },
                "burst": { "type": "integer", "minimum": 1 },
                "disabled": { "type": "boolean" }
              }
            },
            "security": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "allowLoopbackEgress": { "type": "boolean" },
                "allowPrivateEgress": { "type": "boolean" },
                "trustedProxyHops": { "type": "integer", "minimum": 0 }
              }
            },
            "oidc": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "issuerURL": { "type": "string" },
                "clientID": { "type": "string" },
                "clientSecret": { "type": "string" },
                "redirectURI": { "type": "string" },
                "scopes": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "customWebhooks": { "type": "array" }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "embedded": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "image": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 },
                "pullPolicy": {
                  "type": "string",
                  "enum": ["Always", "IfNotPresent", "Never"]
                }
              }
            },
            "service": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "headless": { "type": "boolean" },
                "annotations": { "type": "object" }
              }
            },
            "auth": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "database": { "type": "string", "minLength": 1 },
                "username": { "type": "string", "minLength": 1 },
                "password": { "type": ["string", "null"] },
                "existingSecret": { "type": "string" },
                "secretKeys": { "type": "object" }
              }
            },
            "persistence": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "existingClaim": { "type": "string" },
                "accessModes": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "size": { "type": "string", "minLength": 1 },
                "storageClass": { "type": "string" },
                "annotations": { "type": "object" }
              }
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" },
        "namespaceSelector": { "type": "object" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "path": { "type": "string" },
        "scheme": { "type": "string", "enum": ["http", "https"] },
        "tlsConfig": { "type": "object" },
        "bearerTokenSecret": { "type": "object" },
        "relabelings": { "type": "array" },
        "metricRelabelings": { "type": "array" },
        "targetLabels": { "type": "array" },
        "podTargetLabels": { "type": "array" }
      }
    },
    "grafanaDashboard": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" }
      }
    },
    "helmTest": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "image": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "dnsImage": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "httpProbe": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
